# GLPI connection
GLPI_URL=https://your-instance.example
GLPI_USERNAME=
GLPI_PASSWORD=

# Impact item used by inspection examples
GLPI_ITEMTYPE=Computer
GLPI_ITEM_ID=

# Source and target used by edge examples
GLPI_SOURCE_TYPE=Computer
GLPI_SOURCE_ID=15
GLPI_TARGET_TYPE=Computer
GLPI_TARGET_ID=16

# Explicit write guard. Leave blank for dry-run.
# Set exactly YES only when you intend to persist the prepared relationship.
GLPI_CONFIRM_SAVE=

# Optional Playwright authentication state generated locally.
# Never commit the referenced state file.
GLPI_STATE=.glpi-storage-state.json
